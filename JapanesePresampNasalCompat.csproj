<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KanataWarutsuPhonemizer</AssemblyName>
    <RootNamespace>OpenUtau.Plugin.KanataWarutsuPhonemizer</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="OpenUtau/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="OpenUtau/OpenUtau.Core/OpenUtau.Core.csproj" />
    <ProjectReference Include="OpenUtau/OpenUtau.Plugin.Builtin/OpenUtau.Plugin.Builtin.csproj" />
  </ItemGroup>
</Project>
